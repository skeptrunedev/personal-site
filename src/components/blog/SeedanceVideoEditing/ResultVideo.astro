---
import videoUrl from "../../../assets/images/blog-posts/SeedanceVideoEditing/blog-result.mp4?url";
import poster from "../../../assets/images/blog-posts/SeedanceVideoEditing/generated-wide.jpg";
---

<figure>
  <video controls playsinline preload="metadata" poster={poster.src} width="1440" height="1080" aria-label="AI character edit with Palmer Luckey on the left and Paul Graham on the right performing Hotel Lobby">
    <source src={videoUrl} type="video/mp4" />
    <a href={videoUrl}>Download the video</a>
  </video>
  <figcaption>Hotel Lobby character edit: Palmer Luckey on the left and Paul Graham on the right, using the original performance audio.</figcaption>
</figure>

<style>
  figure { margin: 1.5rem 0 2rem; }
  video { display: block; width: 100%; height: auto; border-radius: 0.375rem; }
  figcaption { margin-top: 0.6rem; font-size: 0.85rem; line-height: 1.55; }
</style>
