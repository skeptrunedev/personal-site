---
import Figure from "./Figure.astro";
import palmerOutfit from "../../../assets/images/blog-posts/SeedanceVideoEditing/palmer-full-body-npr-reference.jpg";
import palmerBody from "../../../assets/images/blog-posts/SeedanceVideoEditing/palmer-full-body-latimes-reference.jpg";
import palmerFace from "../../../assets/images/blog-posts/SeedanceVideoEditing/palmer-face-reference.jpg";
import paulRecent from "../../../assets/images/blog-posts/SeedanceVideoEditing/paul-recent-reference.jpg";
import paulFace from "../../../assets/images/blog-posts/SeedanceVideoEditing/paul-face-reference.jpg";
import paulOutfit from "../../../assets/images/blog-posts/SeedanceVideoEditing/paul-outfit-reference.jpg";
const { person } = Astro.props as { person: "palmer" | "paul" };
const references = person === "palmer" ? [
  { image: palmerOutfit, alt: "Full body photo of Palmer Luckey in a red Hawaiian shirt, khaki cargo shorts and dark thong flip flops, with both feet visible", caption: "Image 1. Palmer's primary outfit reference. The red shirt, cargo pockets, bare legs and both flip flops are visible.", source: "https://www.kpbs.org/news/national/2024/07/09/he-created-oculus-headsets-as-a-teenager-now-he-makes-ai-weapons-for-ukraine", credit: "Philip Cheung for NPR" },
  { image: palmerBody, alt: "Full body photo of Palmer Luckey in a pale Hawaiian shirt, black shorts and flip flops beside an underwater vehicle", caption: "Image 2. A second full body view for Palmer's build and footwear. The prompt says to ignore this photo's different shirt and black shorts, and follow Image 1 for his outfit.", source: "https://www.latimes.com/la-influential/story/2024-06-30/palmer-luckey-anduril", credit: "Christina House / Los Angeles Times" },
  { image: palmerFace, alt: "Palmer Luckey facing the camera at CES 2026 with wavy dark hair and a pointed chin goatee", caption: "Image 3. Recent facial detail from CES 2026. Ignore the watch and clip microphone. This is the uploaded copy with its orientation corrected.", source: "https://commons.wikimedia.org/wiki/File:CES_2026_-_Palmer_Luckey_01_(cropped).jpg", credit: "Xuthoria / WikiPortraits", license: "CC BY SA 4.0", licenseUrl: "https://creativecommons.org/licenses/by-sa/4.0/" },
] : [
  { image: paulRecent, alt: "Paul Graham on the left beside Peter Mangan, wearing a blue shirt, tan shorts and sandals", caption: "Image 4. Paul is the man on the left in this photo. I used his gray hair and current appearance, while assigning him to the right in the video.", source: "https://www.linkedin.com/posts/peter-mangan-34b44871_y-combinator-turned-20-yesterday-heres-activity-7305569506913857537-ZcEY", credit: "Peter Mangan" },
  { image: paulFace, alt: "A detailed older portrait of Paul Graham speaking into a microphone", caption: "Image 5. An older photo with clear facial detail. The prompt says to keep the age and hair from Image 4.", source: "https://www.flickr.com/photos/pragdave/173643703/", credit: "Dave Thomas", license: "CC BY 2.0", licenseUrl: "https://creativecommons.org/licenses/by/2.0/" },
  { image: paulOutfit, alt: "Paul Graham standing at the far right of a YC room in a pale polo, gray shorts and brown sandals", caption: "Image 6. Paul is standing at the far right. This is the polo, shorts and sandals reference. Cargo pockets are not clearly visible here, which matters when assessing the result.", source: "https://commons.wikimedia.org/wiki/File:Paul_Graham_talking_about_Prototype_Day_at_Y_Combinator_Summer_2009.jpg", credit: "Kevin Hale", license: "CC BY SA 2.0", licenseUrl: "https://creativecommons.org/licenses/by-sa/2.0/" },
];
---

<div class:list={["references", { "full-body": person === "palmer" }]}>
  {references.map((reference) => <Figure {...reference} />)}
</div>

<style>
  .references { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.25rem; align-items: start; }
  .references.full-body { grid-template-columns: 1fr; }
  .references :global(figure:last-child) { grid-column: 1 / -1; }
  @media (max-width: 560px) { .references { grid-template-columns: 1fr; } }
</style>
