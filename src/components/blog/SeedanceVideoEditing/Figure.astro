---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  source?: string;
  credit?: string;
  license?: string;
  licenseUrl?: string;
}
const { image, alt, caption, source, credit, license, licenseUrl } = Astro.props;
---

<figure>
  <a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`View full image: ${alt}`}>
    <Image src={image} alt={alt} width={Math.min(image.width, 1200)} format="webp" loading="lazy" />
  </a>
  <figcaption>
    {caption}
    {source && <><span> </span><a href={source}>{credit ?? "Source"}</a>.</>}
    {license && licenseUrl && <><span> </span><a href={licenseUrl}>{license}</a>.</>}
  </figcaption>
</figure>

<style>
  figure { margin: 1.5rem 0 2rem; min-width: 0; }
  img { display: block; width: 100%; height: auto; border-radius: 0.375rem; }
  figcaption { margin-top: 0.6rem; font-size: 0.85rem; line-height: 1.55; }
</style>
