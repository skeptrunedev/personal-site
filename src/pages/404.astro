---
import SimpleLayout from "@layouts/Simple.astro";
import { Icon } from "astro-icon/components";
---

<SimpleLayout
  title="404 - Page Not Found | Nick Khami's Blog"
  type="website"
  description="The page you're looking for doesn't exist."
>
  <article>
    <h1 class="flex items-center gap-2">404 - Page Not Found</h1>
    <p>
      Sorry, the page you're looking for doesn't exist. It may have been moved
      or deleted.
    </p>
    <p>
      <a href="/" class="flex items-center gap-2"
        ><Icon name="bi:house" /> Go back to the home page</a
      >
    </p>
  </article>
</SimpleLayout>
