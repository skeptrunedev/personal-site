{
  "name": "skeptrune-personal-website",
  "description": "Minimal Astro template using PicoCSS and Tailwind CSS.",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && yarn mv-html && yarn convert-to-markdown",
    "mv-html": "mkdir -p dist/html && find dist -type f -name '*.html' -not -path 'dist/html/*' -exec sh -c 'for f; do dest=\"dist/html/${f#dist/}\"; mkdir -p \"$(dirname \"$dest\")\"; mv -f \"$f\" \"$dest\"; done' sh {} +",
    "convert-to-markdown": "bash convert-to-markdown.sh",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdoc": "0.15.7",
    "@astrojs/mdx": "4.3.6",
    "@astrojs/rss": "4.0.12",
    "@astrojs/sitemap": "3.6.0",
    "@tailwindcss/vite": "4.1.13",
    "astro": "5.14.1",
    "astro-icon": "1.1.5",
    "buffer": "6.0.3",
    "markdown-it": "14.1.0",
    "plotly.js-dist": "3.1.0",
    "sanitize-html": "2.17.0",
    "tailwindcss": "4.1.13",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@iconify-json/bi": "1.2.6",
    "@iconify-json/simple-icons": "1.2.53",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.4",
    "@types/plotly.js": "3.0.6",
    "@types/three": "0.180.0",
    "@wcj/html-to-markdown-cli": "^2.1.0",
    "vite-plugin-devtools-json": "1.0.0",
    "wrangler": "4.40.2"
  },
  "packageManager": "yarn@4.9.2"
}
